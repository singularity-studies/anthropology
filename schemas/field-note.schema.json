{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/anthropology/schemas/field-note.schema.json",
  "title": "Blank field-note methodological record",
  "type": "object",
  "x-instrument-version": "0.2.0-draft",
  "additionalProperties": false,
  "required": [
    "record_type",
    "instrument_version",
    "methodological_record_id",
    "encounter_scope",
    "observation",
    "participant_account",
    "researcher_interpretation",
    "analytic_memo",
    "reflexivity"
  ],
  "properties": {
    "record_type": {"const": "field_note"},
    "instrument_version": {"type": "string", "minLength": 1},
    "methodological_record_id": {"type": "string", "minLength": 1},
    "encounter_scope": {"type": "string"},
    "observation": {"type": "string"},
    "participant_account": {"type": "string"},
    "researcher_interpretation": {"type": "string"},
    "analytic_memo": {"type": "string"},
    "reflexivity": {"$ref": "#/$defs/reflexivity"}
  },
  "$defs": {
    "reflexivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researcher_role_position",
        "access_conditions",
        "field_relationship_change",
        "interpretive_uncertainty",
        "methodological_change"
      ],
      "properties": {
        "researcher_role_position": {"type": "string"},
        "access_conditions": {"type": "string"},
        "field_relationship_change": {"type": "string"},
        "interpretive_uncertainty": {"type": "string"},
        "methodological_change": {"type": "string"}
      }
    }
  }
}
