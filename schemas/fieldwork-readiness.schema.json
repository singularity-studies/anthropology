{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/singularity-studies/anthropology/schemas/fieldwork-readiness.schema.json",
  "title": "Fieldwork readiness record",
  "type": "object",
  "x-instrument-version": "0.2.0-draft",
  "additionalProperties": false,
  "required": [
    "readiness_version",
    "status",
    "execution_permitted",
    "determinations",
    "external_requirements_notice"
  ],
  "properties": {
    "readiness_version": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["FIELDWORK_NOT_AUTHORIZED", "FIELDWORK_AUTHORIZED"]
    },
    "execution_permitted": {"type": "boolean"},
    "determinations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ethics_or_research_review",
        "consent_or_lawful_alternative",
        "data_management_plan",
        "privacy_and_deidentification_plan",
        "withdrawal_and_correction_process",
        "nonpublic_access_and_storage_plan",
        "public_release_and_disclosure_review",
        "responsible_research_role"
      ],
      "properties": {
        "ethics_or_research_review": {"$ref": "#/$defs/readiness_slot"},
        "consent_or_lawful_alternative": {"$ref": "#/$defs/readiness_slot"},
        "data_management_plan": {"$ref": "#/$defs/readiness_slot"},
        "privacy_and_deidentification_plan": {"$ref": "#/$defs/readiness_slot"},
        "withdrawal_and_correction_process": {"$ref": "#/$defs/readiness_slot"},
        "nonpublic_access_and_storage_plan": {"$ref": "#/$defs/readiness_slot"},
        "public_release_and_disclosure_review": {"$ref": "#/$defs/readiness_slot"},
        "responsible_research_role": {"$ref": "#/$defs/readiness_slot"}
      }
    },
    "external_requirements_notice": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^governance/determinations/[A-Za-z0-9._-]+\\.json$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "readiness_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_reference", "note"],
      "properties": {
        "record_reference": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifact_reference"}
          ]
        },
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
